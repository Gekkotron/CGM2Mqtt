# --- FreeStyle LibreLinkUp credentials ---
LIBRE_EMAIL=you@example.com
LIBRE_PASSWORD=your-password
# Optional: force a region (eu, us, de, fr, ...). Leave blank to auto-detect.
LIBRE_REGION=

# --- MQTT broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=cgm2mqtt
MQTT_TLS=false
# Base topic. Final topics are <base>/last, <base>/history, <base>/update, <base>/status
MQTT_BASE_TOPIC=cgm

# --- Polling ---
# Seconds between automatic fetches (LibreLinkUp updates roughly every minute).
POLL_INTERVAL=60
LOG_LEVEL=INFO
